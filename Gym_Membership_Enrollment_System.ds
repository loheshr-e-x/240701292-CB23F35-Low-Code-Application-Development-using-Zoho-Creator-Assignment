		workflow
		{
		form
		{
			Hide_Address_field as "Hide Address field"
			{
				type =  form
				form = membership_enrollment

				record event = on add or edit

				field rules
				{
					actions 
					{
						disable residential_address;
					}
				}

			}
			Form_Submission_Mail as "Form Submission Mail"
			{
				type =  form
				form = membership_enrollment

				record event = on add or edit

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.loginuserid"
							to : email_address
							subject : "Record Added or Updated"
							message : "<div>${zoho.loginuserid} has added or updated a record in form Membership Enrollment<span style=\"font-family: Heuristica, sans-serif;\" class=\"font\">​</span><br></div>"
							attachments : template : _default1 as inline
						)
					}
				}

			}
		}

		schedule
		{
			renewal_due_date_reminder as "Renewal Due Date Reminder"
			{
				type =  schedule
				form = membership_enrollment
					status = inactive
				start = renewal_due_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch the membership renewal date from the input record
										renewalDate = input.renewal_due_date;
										// Calculate 7 days before renewal date
										sevenDaysBefore = renewalDate.addDay(-7);
										// Get today's date
										todayDate = today;
										// Check if today is 7 days before renewal date
										if(sevenDaysBefore == todayDate)
										{
											// Prepare the email subject and message
											subject = "Reminder: Your Membership Renewal is Approaching";
											message = "Dear " + input.member_name.first_name + ",\n\nThis is a friendly reminder that your gym membership is due for renewal on " + renewalDate.toString() + ". Please visit our website to renew your membership and continue enjoying all the benefits.\n\nThank you!";
											message.insert(renewalDate);
											// Send the email using the admin's email as sender
											sendmail
											[
												from :zoho.adminuserid
												to :input.email_address
												subject :subject
												message :message
												content type :HTML
											]
										}
					)
					}
					actions 
					{
					on load
					(
						// Fetch the membership renewal date from the input record
										renewalDate = input.renewal_due_date;
										// Calculate 7 days before renewal date
										sevenDaysBefore = renewalDate.addDay(-3);
										// Get today's date
										todayDate = today;
										// Check if today is 7 days before renewal date
										if(sevenDaysBefore == todayDate)
										{
											// Prepare the email subject and message
											subject = "Reminder: Your Membership Renewal is Approaching";
											message = "Dear " + input.member_name.first_name + ",\n\nThis is a friendly reminder that your gym membership is due for renewal on " + renewalDate.toString() + ". Please visit our website to renew your membership and continue enjoying all the benefits.\n\nThank you!";
											message.insert(renewalDate);
											// Send the email using the admin's email as sender
											sendmail
											[
												from :zoho.adminuserid
												to :input.email_address
												subject :subject
												message :message
												content type :HTML
											]
										}
					)
					}
					actions 
					{
					on load
					(
						// Fetch the membership renewal date from the input record
										renewalDate = input.renewal_due_date;
										// Calculate 7 days before renewal date
										sevenDaysBefore = renewalDate.addDay(-0);
										// Get today's date
										todayDate = today;
										// Check if today is 7 days before renewal date
										if(sevenDaysBefore == todayDate)
										{
											// Prepare the email subject and message
											subject = "Reminder: Your Membership Renewal is Approaching";
											message = "Dear " + input.member_name.first_name + ",\n\nThis is a friendly reminder that your gym membership is due for renewal on " + renewalDate.toString() + ". Please visit our website to renew your membership and continue enjoying all the benefits.\n\nThank you!";
											message.insert(renewalDate);
											// Send the email using the admin's email as sender
											sendmail
											[
												from :zoho.adminuserid
												to :input.email_address
												subject :subject
												message :message
												content type :HTML
											]
										}
					)
					}
				}
			}
		}

		approval
		{
			Trainer_Trainee_Approval as "Trainer Trainee Approval"
			{
				type =  approval
				form = trainers
				display fields = [trainer_name,specialization,status]
				on start
				{
				}
				on level 1
				{
					approvers
					(
			 			role = "CEO"
					)
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : "zoho.loginuserid"
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : "zoho.loginuserid"
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
					}
				}
			}
		}

