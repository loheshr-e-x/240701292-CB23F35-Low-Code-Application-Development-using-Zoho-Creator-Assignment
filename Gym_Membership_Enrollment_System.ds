n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '0px'\n\tmarginRight = '6px' \n\n\tcolor = '#3F3F3F'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\twidth = '40px'\n\theight = '40px'\n\ttype = 'icon'\n\tvalue = 'ui-2-square-add-08'\n\tsize = '14px'\n\tcornerRadius = '20px'\n\ticonType = 'outline'\n/>\n</pc><pc \n\t\n>\n\t<text \n\n\tcolor = '#3F3F3F'\n\tsize = '14px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\n\n\n\n\n\t  value = 'Show All Membership Enrollments'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart'\n\n\ttype = 'Bar'\n\txtitle = 'Membership Type'\n\tytitle = 'Count'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'membership_enrollment'\n\txfield = 'membership_type'\n\tyfields = 'count:membership_type'\n\tshowDataLabel = 'true'\n\tunderlyingReport = 'membership_enrollment_Report'\n/>\n\n</column><column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart 2'\n\n\t\n\ttitle = 'Distribution by Membership Plan'\n\t\n\t\ttitleSize = '16px'\n\t\ttitleColor = '#222326'\n\ttype = 'Pie'\n\txtitle = 'Membership Plan'\n\tytitle = 'Membership Plan'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'membership_enrollment'\n\txfield = 'membership_plan'\n\tyfields = 'count:membership_plan'\n\tgroupBy = 'membership_id'\n\t\tDelugeCriteria = 'membership_plan is not null &amp;&amp; membership_plan != &quot;&quot;'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<viewer\n\telementName='AR Viewer'\n\ntype = 'AR'\n     heightType = 'auto'\n    directInput = '${gym_rules_waiver_snippet}'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet()\ncontent\n&lt;%{\n\t%&gt;\n&lt;!DOCTYPE html&gt;\n&lt;html lang=&quot;en&quot;&gt;\n&lt;head&gt;\n  &lt;meta charset=&quot;UTF-8&quot; /&gt;\n  &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;/&gt;\n  &lt;title&gt;Gym Membership Rules &amp; Liability Waiver&lt;/title&gt;\n  &lt;style&gt;\n    body {\n      font-family: &apos;Segoe UI&apos;, Tahoma, Geneva, Verdana, sans-serif;\n      background-color: #f9f9f9;\n      margin: 0;\n      padding: 20px;\n      color: #333;\n    }\n\n    .container {\n      max-width: 700px;\n      margin: 40px auto;\n      background: #fff;\n      padding: 40px;\n      border-radius: 12px;\n      box-shadow: 0 6px 20px rgba(0,0,0,0.1);\n    }\n\n    h1 {\n      color: #2c3e50;\n      text-align: center;\n      margin-bottom: 30px;\n      font-size: 28px;\n    }\n\n    .section {\n      margin-bottom: 25px;\n    }\n\n    .section h2 {\n      font-size: 20px;\n      color: #2980b9;\n      margin-bottom: 15px;\n      border-bottom: 2px solid #3498db;\n      padding-bottom: 5px;\n    }\n\n    ul {\n      list-style-type: disc;\n      padding-left: 20px;\n    }\n\n    li {\n      margin-bottom: 10px;\n      line-height: 1.6;\n    }\n\n    .waiver {\n      background-color: #fef9e7;\n      border-left: 5px solid #f1c40f;\n      padding: 15px\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</column>\n</row>\n</layout>\n</zml>"
		}
