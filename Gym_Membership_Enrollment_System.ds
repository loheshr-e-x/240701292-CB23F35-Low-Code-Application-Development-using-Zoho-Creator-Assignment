 application "Gym Membership Enrollment System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form family_member
		{
			displayname = "Family Member"
			success message = "Family Member Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			full_name
			(
    			type = text
				displayname = "Full Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			relationship
			(
				type = picklist
				displayname = "Relationship"
				values = {"Spouse","Parent","Sibling","Child"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			parent_member
			(
				type = picklist	
				displayname = "Parent Member"
				values  = membership_enrollment.ID
    			displayformat = [membership_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form membership_enrollment
		{
			displayname = "Membership Enrollment"
			success message = "Membership Enrollment Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			membership_id
			(
    			type = text
				displayname = "Membership ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			member_name
			(
    			type = name
				displayname = "Member Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			age
			(
				type = number
				displayname = "Age"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			membership_type
			(
				type = picklist
				displayname = "Membership Type"
				values = {"New Member","Corporate Enrollment","Renewal"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Enrolled","Enquiry","Active","Expired"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			email_address
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			residential_address
			(
    			type = address
				displayname = "Residential Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			emergency_contact_name
			(
    			type = text
				displayname = "Emergency Contact Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			membership_plan
			(
				type = picklist
				displayname = "Membership Plan"
				values = {"Quarterly Plan","Half-Yearly Plan","Monthly Plan","Annual Plan"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_activities
			(
				type = list	
				displayname = "Preferred Activities"
				values = {"Weight Training","Cardio","Crossfit","Zumba","Yoga","Swimming"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			fitness_goals_medical_notes
			(
    			type = textarea
				displayname = "Fitness Goals Medical Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_start_date
			(
    			type = date
				displayname = "Preferred Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_workout_slot
			(
    			type = time
				displayname = "Preferred Workout Slot"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			health_declaration_waiver
			(
    			type = checkbox
				displayname = "Health Declaration Waiver"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_trainer
			(
				type = picklist	
				displayname = "Assigned Trainer"
				values  = trainers.ID
    			displayformat = [trainer_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			member_photo
			(
    			type = text
				displayname = "Member Photo"
	 			row = 1
	 			column = 1   
				width = medium
			)
			medical_certificate_upload
			(
    			type = text
				displayname = "Medical Certificate Upload"
	 			row = 1
	 			column = 1   
				width = medium
			)
			current_bmi
			(
				type = decimal
				displayname = "Current BMI"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			family_members_enrolled
			(
    			type = text
				displayname = "Family Members Enrolled"
	 			row = 1
	 			column = 1   
				width = medium
			)
			fitness_social_profile_url
			(
    			type = url
				displayname = "Fitness Social Profile URL"
	 			row = 1
	 			column = 1   
				width = medium
			)
			fitness_goal_video_intro
			(
    			type = text
				displayname = "Fitness Goal Video Intro"
	 			row = 1
	 			column = 1   
				width = medium
			)
			health_concern_voice_note
			(
    			type = text
				displayname = "Health Concern Voice Note"
	 			row = 1
	 			column = 1   
				width = medium
			)
			requires_personal_trainer
			(
    			type = checkbox
				displayname = "Requires Personal Trainer"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			membership_fee_paid
			(
				displayname = "Membership Fee Paid"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			referral_discount_percent
			(
    			type = percentage
				displayname = "Referral Discount Percent"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			total_amount_payable
			(
				displayname = "Total Amount Payable"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			member_digital_signature
			(
    			type = text
				displayname = "Member Digital Signature"
	 			row = 1
	 			column = 1   
				width = medium
			)
			enrollment_submitted_on
			(
    			type = datetime
				displayname = "Enrollment Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			member_access_qr_code
			(
    			type = text
				displayname = "Member Access QR Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			attendance_today
			(
				type = radiobuttons
				displayname = "Attendance Today"
				values = {"Present","Absent"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			fee_paid_status
			(
				type = picklist
				displayname = "Fee Paid Status"
				values = {"Paid","Overdue","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			renewal_due_date
			(
    			type = date
				displayname = "Renewal Due Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Enquiry Received","Data Verification","Enquiry Rejected","Medical Review","Pending Payment","Trainer Assignment","Onboarding","Active Member","Renewal Pending","Membership Suspended","Membership Terminated"}
			}
		}
		form trainers
		{
			displayname = "Trainers"
			success message = "Trainers Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			trainer_name
			(
    			type = name
				displayname = "Trainer Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			specialization
			(
    			type = text
				displayname = "Specialization"
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Active","On Leave","Inactive"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Form Submission","Approval","Stage3"}
			}
		}
	}
	reports
	{
		kanban MEMERSHIP_KANBAN
		{
			displayName = "MEMERSHIP KANBAN"
			show all rows from membership_enrollment    
			(
				membership_id as "Membership ID"
				member_name  as "Member Name"
				age as "Age"
				membership_type as "Membership Type"
				status as "Status"
				email_address as "Email Address"
				contact_number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				emergency_contact_name as "Emergency Contact Name"
				membership_plan as "Membership Plan"
				preferred_activities as "Preferred Activities"
				fitness_goals_medical_notes as "Fitness Goals Medical Notes"
				preferred_start_date as "Preferred Start Date"
				preferred_workout_slot as "Preferred Workout Slot"
				health_declaration_waiver as "Health Declaration Waiver"
				assigned_trainer as "Assigned Trainer"
				member_photo as "Member Photo"
				medical_certificate_upload as "Medical Certificate Upload"
				current_bmi as "Current BMI"
				family_members_enrolled as "Family Members Enrolled"
				fitness_social_profile_url as "Fitness Social Profile URL"
				fitness_goal_video_intro as "Fitness Goal Video Intro"
				health_concern_voice_note as "Health Concern Voice Note"
				requires_personal_trainer as "Requires Personal Trainer"
				membership_fee_paid as "Membership Fee Paid"
				referral_discount_percent as "Referral Discount Percent"
				total_amount_payable as "Total Amount Payable"
				member_digital_signature as "Member Digital Signature"
				enrollment_submitted_on as "Enrollment Submitted On"
				member_access_qr_code as "Member Access QR Code"
				attendance_today as "Attendance Today"
				fee_paid_status as "Fee Paid Status"
				renewal_due_date as "Renewal Due Date"
			)
			options
			(
	 			display field = membership_plan
	 		)
		}
		list membership_enrollment_Report
		{
			displayName = "All Membership Enrollments"
			show all rows from membership_enrollment    
			(
				membership_id as "Membership ID"
				member_name  as "Member Name"
				age as "Age"
				membership_type as "Membership Type"
				status as "Status"
				email_address as "Email Address"
				contact_number as "Contact Number"
				residential_address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				emergency_contact_name as "Emergency Contact Name"
				membership_plan as "Membership Plan"
				preferred_activities as "Preferred Activities"
				fitness_goals_medical_notes as "Fitness Goals Medical Notes"
				preferred_start_date as "Preferred Start Date"
				preferred_workout_slot as "Preferred Workout Slot"
				health_declaration_waiver as "Health Declaration Waiver"
				assigned_trainer as "Assigned Trainer"
				member_photo as "Member Photo"
				medical_certificate_upload as "Medical Certificate Upload"
				current_bmi as "Current BMI"
				family_members_enrolled as "Family Members Enrolled"
				fitness_social_profile_url as "Fitness Social Profile URL"
				fitness_goal_video_intro as "Fitness Goal Video Intro"
				health_concern_voice_note as "Health Concern Voice Note"
				requires_personal_trainer as "Requires Personal Trainer"
				membership_fee_paid as "Membership Fee Paid"
				(
					display = total,average,min,max	
				)
				referral_discount_percent as "Referral Discount Percent"
				(
					display = total,average,min,max	
				)
				total_amount_payable as "Total Amount Payable"
				(
					display = total,average,min,max	
				)
				member_digital_signature as "Member Digital Signature"
				enrollment_submitted_on as "Enrollment Submitted On"
				member_access_qr_code as "Member Access QR Code"
				attendance_today as "Attendance Today"
				fee_paid_status as "Fee Paid Status"
				renewal_due_date as "Renewal Due Date"
				ID
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (status == "Active")
				fields = [status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (status == "Enquiry")
				fields = [status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (status == "Enrolled")
				fields = [status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban membership_enrollment_by_status
		{
			displayName = "Statuses"
			show all rows from membership_enrollment    
			(
				membership_id as "Membership ID"
				member_name  as "Member Name"
				age as "Age"
				membership_type as "Membership Type"
				status as "Status"
				email_address as "Email Address"
				contact_number as "Contact Number"
				residential_address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				emergency_contact_name as "Emergency Contact Name"
				membership_plan as "Membership Plan"
				preferred_activities as "Preferred Activities"
				fitness_goals_medical_notes as "Fitness Goals Medical Notes"
				preferred_start_date as "Preferred Start Date"
				preferred_workout_slot as "Preferred Workout Slot"
				health_declaration_waiver as "Health Declaration Waiver"
				assigned_trainer as "Assigned Trainer"
				member_photo as "Member Photo"
				medical_certificate_upload as "Medical Certificate Upload"
				current_bmi as "Current BMI"
				family_members_enrolled as "Family Members Enrolled"
				fitness_social_profile_url as "Fitness Social Profile URL"
				fitness_goal_video_intro as "Fitness Goal Video Intro"
				health_concern_voice_note as "Health Concern Voice Note"
				requires_personal_trainer as "Requires Personal Trainer"
				membership_fee_paid as "Membership Fee Paid"
				(
					display = total,average,min,max	
				)
				referral_discount_percent as "Referral Discount Percent"
				(
					display = total,average,min,max	
				)
				total_amount_payable as "Total Amount Payable"
				(
					display = total,average,min,max	
				)
				member_digital_signature as "Member Digital Signature"
				enrollment_submitted_on as "Enrollment Submitted On"
				member_access_qr_code as "Member Access QR Code"
				attendance_today as "Attendance Today"
				fee_paid_status as "Fee Paid Status"
				renewal_due_date as "Renewal Due Date"
			)
			options
			(
	 			display field = status
	 		)
		}
		list trainers_Report
		{
			displayName = "All Trainers"
			show all rows from trainers    
			(
				trainer_name  as "Trainer Name"
				specialization as "Specialization"
				status as "Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (status == "Active")
				fields = [status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (status == "Inactive")
				fields = [status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (status == "On Leave")
				fields = [status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban trainers_by_status
		{
			displayName = "Statuses"
			show all rows from trainers    
			(
				trainer_name  as "Trainer Name"
				specialization as "Specialization"
				status as "Status"
			)
			options
			(
	 			display field = status
	 		)
		}
		list family_member_Report
		{
			displayName = "All Family Members"
			show all rows from family_member    
			(
				full_name as "Full Name"
				relationship as "Relationship"
				parent_member as "Parent Member"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (relationship == "Child")
				fields = [relationship]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (relationship == "Parent")
				fields = [relationship]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (relationship == "Spouse")
				fields = [relationship]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban family_member_by_relationship
		{
			displayName = "Relationships"
			show all rows from family_member    
			(
				full_name as "Full Name"
				relationship as "Relationship"
				parent_member as "Parent Member"
			)
			options
			(
	 			display field = relationship
	 		)
		}
	}
	pages
	{
		page DashBoard(string gym_rules_waiver_snippet)
